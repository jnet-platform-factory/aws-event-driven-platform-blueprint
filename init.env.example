# The answers bin/init needs. Copy to init.env (git-ignored: it names your
# accounts), fill it in, and run `make init`. Format: KEY="value".

# Display name, and the lowercase prefix every resource name starts with.
TENANT="Example"
PREFIX="example"

# The GitHub organisation and this repository's name. Their numeric ids are
# looked up with gh when left empty (the OIDC trust names them).
GITHUB_ORG="example-org"
PLATFORM_REPO="example-platform"
GITHUB_ORG_ID=""
PLATFORM_REPO_ID=""

# Other repositories that deploy SAM / CloudFormation applications into these
# accounts, space-separated. They get the app deploy roles too.
APP_REPOS=""

# One AWS account per environment, never shared. The profiles are aws-vault's.
DEV_ACCOUNT_ID="111122223333"
DEV_PROFILE="example-dev"
PRODUCTION_ACCOUNT_ID="444455556666"
PRODUCTION_PROFILE="example-production"

# Where the workloads run, and where events-observability runs: its SAR
# application must be published in that region, and the event bus lives there.
PRIMARY_REGION="us-east-1"
EO_REGION="us-east-1"

# The account that publishes the events-observability SAR application.
SAR_PUBLISHER_ACCOUNT_ID=""

# The components to keep. aws-account-bootstrap is required; platform-api needs
# infrastructure. All of them:
COMPONENTS="aws-account-bootstrap infrastructure events-observability aws-daily-monitoring-report ssm-parameters platform-api lambda-layers"
