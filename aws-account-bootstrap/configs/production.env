# __TENANT__ production - account __PRODUCTION_ACCOUNT_ID__, aws-vault profile __PRODUCTION_PROFILE__.
#
# Read by the pinned aws-account-bootstrap (see ../Makefile and ../README.md).
# Format: KEY="value", plain double quotes, comments on their own line only -
# the tool's loader takes everything after '=' as the value.
#
# The first line is a contract: `make same-account` and bin/diff-live read the
# account id from it. Keep it "# <label> - account <12 digits>, ...".

GITHUB_ORG="__GITHUB_ORG__"
ALLOWED_REGIONS="__ALLOWED_REGIONS__"

# The Terraform state bucket in this account (infrastructure/live/root.hcl). No
# deploy role may delete it, re-policy it or switch off its versioning. Naming it
# before it exists is harmless: a human creates it once, by hand, with
# `terragrunt init --backend-bootstrap` (see ../../infrastructure/README.md).
STATE_BUCKETS="__PREFIX__-terraform-state-__PRODUCTION_ACCOUNT_ID__"

# --- Platform: Terraform / Terragrunt ------------------------------------------
# __PLATFORM_REPO__ runs Terragrunt (.github/workflows/infrastructure.yml) and
# writes SSM parameters (.github/workflows/ssm-parameters.yml) with this role.
PLATFORM_REPOS="__PLATFORM_REPO__"
# The GitHub environment those jobs run in: the role's trust policy matches it.
# Give it required reviewers and limit it to main before the first deploy.
PLATFORM_ENVIRONMENTS="production"
PLATFORM_ROLE_NAME="platform-deploy-role"
PLATFORM_POLICY_NAME="platform-deploy-policy"

# --- Apps: SAM / CloudFormation ------------------------------------------------
# __PLATFORM_REPO__ deploys platform-api, the base layer and the daily monitoring
# report with these roles; application repositories are listed after it.
APP_REPOS="__APP_REPOS__"
APP_ENVIRONMENTS="production"
APP_ROLE_NAME="app-deploy-role"
APP_POLICY_NAME="app-deploy-policy"
APP_EXEC_ROLE_NAME="app-cfn-exec-role"
APP_EXEC_POLICY_NAME="app-cfn-exec-policy"

LAMBDA_ROLE_NAME="lambda-test-role"
